<Window
    x:Class="DeepSeekPeakWidget.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="个性化设置">

    <Window.SystemBackdrop>
        <DesktopAcrylicBackdrop/>
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid x:Name="SettingsTitleBar" Height="44" Padding="14,0,10,0" Background="Transparent">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                <FontIcon Glyph="&#xE713;" FontSize="14" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                <TextBlock Text="个性化设置" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="18,0,18,0">
            <StackPanel Spacing="4">
                <TextBlock Text="窗口" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Margin="0,4,0,0"/>
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Foreground="{ThemeResource TextFillColorPrimaryBrush}" Text="默认模式" FontSize="12" VerticalAlignment="Center"/>
                    <ComboBox x:Name="ModeCombo" Grid.Column="1" Width="150">
                        <ComboBoxItem Content="完整版" Tag="full"/>
                        <ComboBoxItem Content="简略版" Tag="compact"/>
                    </ComboBox>
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Foreground="{ThemeResource TextFillColorPrimaryBrush}" Text="完整版窗口尺寸（宽 × 高）" FontSize="12" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <TextBox x:Name="WidthBox" Width="56" Text="320" HorizontalTextAlignment="Center"/>
                        <TextBlock Foreground="{ThemeResource TextFillColorPrimaryBrush}" Text="×" VerticalAlignment="Center"/>
                        <TextBox x:Name="HeightBox" Width="56" Text="600" HorizontalTextAlignment="Center"/>
                    </StackPanel>
                </Grid>
                <CheckBox x:Name="TopmostChk" Content="窗口置顶（显示在其他窗口之上）" FontSize="12"/>
                <CheckBox x:Name="PinLockChk" Content="固定窗口位置" FontSize="12"/>

                <TextBlock Text="DeepSeek API" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Margin="0,10,0,0"/>
                <Grid Margin="0,4,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Foreground="{ThemeResource TextFillColorPrimaryBrush}" Text="API Key（查询余额）" FontSize="12" VerticalAlignment="Center"/>
                    <TextBox x:Name="ApiKeyBox" Grid.Column="1" Width="230" FontSize="11"
                             PlaceholderText="sk-...（留空则不显示余额）"/>
                </Grid>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Foreground="{ThemeResource TextFillColorPrimaryBrush}" Text="余额刷新间隔（秒，0=关闭）" FontSize="12" VerticalAlignment="Center"/>
                    <TextBox x:Name="BalanceRefreshBox" Grid.Column="1" Width="64" Text="300" HorizontalTextAlignment="Center"/>
                </Grid>

                <TextBlock Text="外观" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Margin="0,10,0,0"/>
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Foreground="{ThemeResource TextFillColorPrimaryBrush}" Text="主题模式" FontSize="12" VerticalAlignment="Center"/>
                    <ComboBox x:Name="ThemeModeCombo" Grid.Column="1" Width="150">
                        <ComboBoxItem Content="跟随系统" Tag="system"/>
                        <ComboBoxItem Content="深色" Tag="dark"/>
                        <ComboBoxItem Content="浅色" Tag="light"/>
                    </ComboBox>
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Foreground="{ThemeResource TextFillColorPrimaryBrush}" Text="背景效果" FontSize="12" VerticalAlignment="Center"/>
                    <ComboBox x:Name="BackdropCombo" Grid.Column="1" Width="150">
                        <ComboBoxItem Content="无" Tag="none"/>
                        <ComboBoxItem Content="亚克力（模糊）" Tag="acrylic"/>
                    </ComboBox>
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Foreground="{ThemeResource TextFillColorPrimaryBrush}" Text="主题色" FontSize="12" VerticalAlignment="Center"/>
                    <ComboBox x:Name="ThemeCombo" Grid.Column="1" Width="150">
                        <ComboBoxItem Content="蓝色" Tag="blue"/>
                        <ComboBoxItem Content="绿色" Tag="green"/>
                        <ComboBoxItem Content="紫色" Tag="purple"/>
                        <ComboBoxItem Content="橙色" Tag="orange"/>
                        <ComboBoxItem Content="青色" Tag="cyan"/>
                    </ComboBox>
                </Grid>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Foreground="{ThemeResource TextFillColorPrimaryBrush}" Text="背景透明度（亚克力）" FontSize="12" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <Slider x:Name="OpacitySlider" Width="120" Minimum="0.3" Maximum="1" Value="0.97" StepFrequency="0.01"/>
                        <TextBlock x:Name="OpacityText" Text="0.97" FontSize="12" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="时段设置" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Margin="0,10,0,0"/>
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Foreground="{ThemeResource TextFillColorPrimaryBrush}" Text="时区偏移（小时，北京时间 +8）" FontSize="12" VerticalAlignment="Center"/>
                    <TextBox x:Name="OffsetBox" Grid.Column="1" Width="64" Text="8" HorizontalTextAlignment="Center"/>
                </Grid>
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Foreground="{ThemeResource TextFillColorPrimaryBrush}" Text="峰时 1（HH:mm）" FontSize="12" VerticalAlignment="Center"/>
                    <TextBox x:Name="Peak1StartBox" Grid.Column="1" Width="52" Text="09:00" HorizontalTextAlignment="Center"/>
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="至" FontSize="12" Margin="4,0" VerticalAlignment="Center"/>
                    <TextBox x:Name="Peak1EndBox" Grid.Column="3" Width="52" Text="12:00" HorizontalTextAlignment="Center"/>
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Foreground="{ThemeResource TextFillColorPrimaryBrush}" Text="峰时 2（HH:mm）" FontSize="12" VerticalAlignment="Center"/>
                    <TextBox x:Name="Peak2StartBox" Grid.Column="1" Width="52" Text="14:00" HorizontalTextAlignment="Center"/>
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="至" FontSize="12" Margin="4,0" VerticalAlignment="Center"/>
                    <TextBox x:Name="Peak2EndBox" Grid.Column="3" Width="52" Text="18:00" HorizontalTextAlignment="Center"/>
                </Grid>
                <CheckBox x:Name="WeekendChk" Content="周末及节假日全天按谷时计算" FontSize="12"/>
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Foreground="{ThemeResource TextFillColorPrimaryBrush}" Text="定价刷新间隔（分钟，0=关闭）" FontSize="12" VerticalAlignment="Center"/>
                    <TextBox x:Name="RefreshBox" Grid.Column="1" Width="64" Text="30" HorizontalTextAlignment="Center"/>
                </Grid>

                <TextBlock Text="提醒" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Margin="0,10,0,0"/>
                <CheckBox x:Name="NotifyChk" Content="启用切换提醒（系统通知）" FontSize="12"/>
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Foreground="{ThemeResource TextFillColorPrimaryBrush}" Text="提前提醒（分钟）" FontSize="12" VerticalAlignment="Center"/>
                    <TextBox x:Name="AdvanceBox" Grid.Column="1" Width="64" Text="10" HorizontalTextAlignment="Center"/>
                </Grid>
                <CheckBox x:Name="ChangeChk" Content="时段切换时立即提醒" FontSize="12"/>

                <TextBlock Text="API Key 仅保存在本地配置文件中，用于查询 DeepSeek 账户余额；留空则不显示余额。背景透明度只作用于亚克力背景，窗口内容保持不透明；背景效果为“无”时该设置不生效。定价刷新间隔到点会自动重读配置文件中的价格。峰时 09:00-12:00、14:00-18:00（北京时间），谷时价格减半。"
                           FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,8,0,4"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Padding="18,12">
            <Button x:Name="BtnSave" Content="保存" Width="84" Height="32" Margin="0,0,10,0"
                    Background="#2E7D32" Foreground="White" Click="Save_Click"/>
            <Button x:Name="BtnCancel" Content="取消" Width="84" Height="32" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
